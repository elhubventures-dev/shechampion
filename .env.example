# -----------------------------------------------------------------------------
# SHE CHAMPIONS — Event registration & payment
# Copy to .env.local (local) or .env.staging.local (staging workstation).
# Never commit real secrets. Public registration stays CLOSED by default.
# -----------------------------------------------------------------------------

# Environment isolation
# For staging migrations/smoke: APP_ENV=staging and ALLOW_STAGING_MIGRATE=true
APP_ENV=
ALLOW_STAGING_MIGRATE=false
ALLOW_PRODUCTION_MIGRATE=false

# Prefer STAGING_DATABASE_URL for staging work. Do not point this at production.
STAGING_DATABASE_URL=
# General DB URL (server-side only). Used by the app; staging migrate may fall back
# to this only when APP_ENV=staging and ALLOW_STAGING_MIGRATE=true.
DATABASE_URL=

# Site URL used for absolute Paystack callback URLs (no trailing slash).
PUBLIC_SITE_URL=http://localhost:3000

# Registration window & approvals (server-side gates)
# EVENT_REGISTRATION_ENABLED must be exactly "true" to allow payment init.
EVENT_REGISTRATION_ENABLED=false
# ISO-8601 timestamps with Africa/Lagos offset (+01:00), e.g. 2026-11-01T09:00:00+01:00
# Cutoff is exactly 48 hours before EVENT_START_AT. Exact start time is still unconfirmed.
EVENT_REGISTRATION_OPEN_AT=
EVENT_START_AT=
# Must be exactly "true" after owner legal review of draft notices — not for convenience
EVENT_PRIVACY_NOTICE_APPROVED=false
EVENT_PARTICIPATION_TERMS_APPROVED=false

# Paystack (server-side only). Staging must use sk_test_... and PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
PAYSTACK_MODE=test

# Admin authentication (server-validated sessions)
ADMIN_EMAIL=
# Generate with: npm run hash-admin-password
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Transactional email (Resend adapter)
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# Optional overrides (defaults are safe for the 2026 challenge)
# EVENT_ID=bec-2026
# EVENT_FEE_KOBO=500000
# EVENT_CURRENCY=NGN
